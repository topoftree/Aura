+  GpuFlushTracker::GpuFlushTracker(GpuFlushType maxType, bool batchHints)
+  : m_maxType(maxType), m_batchHints(batchHints) {
 
   }
 
+  bool GpuFlushTracker::shouldBatchHint(
+          GpuFlushType flushType,
+          uint64_t chunkId,
+          uint64_t lastCompleteSubmissionId) const {
+    if (!m_batchHints || (flushType != GpuFlushType::ImplicitStrongHint
+                      && flushType != GpuFlushType::ImplicitWeakHint))
+      return false;
+
+    // Completion may advance concurrently; never underflow to a huge backlog.
+    if (lastCompleteSubmissionId >= m_lastFlushSubmissionId)
+      return false;
+
+    bool batch = m_lastFlushSubmissionId - lastCompleteSubmissionId >= 2
+        && chunkId > m_lastFlushChunkId
+        && chunkId - m_lastFlushChunkId < 6;
+    m_batchHintObserved |= batch;
+    return batch;
+  }
