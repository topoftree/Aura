diff --git a/src/dxgi/dxgi_aura_display.h b/src/dxgi/dxgi_aura_display.h
new file mode 100644
index 0000000..19efe1e
--- /dev/null
+++ b/src/dxgi/dxgi_aura_display.h
@@ -0,0 +1,146 @@
+#pragma once
+
+#include "dxgi_include.h"
+#include "../util/util_env.h"
+#include <atomic>
+#include <cerrno>
+#include <cstdio>
+
+namespace dxvk {
+
+  // Startup-only BF3 request tracing. No Present hook, extra GPU/window query,
+  // addresses, paths or config text. A result is an API result, not visible pixels.
+  enum class AuraDisplayCall {
+    Create, CreateHwnd, CreateBase, Construct, ResizeBuffers, ResizeBuffers1,
+    ResizeTarget, Fullscreen, Enter, Leave, ChangeMode, RestoreMode, Closest, Closest1,
+  };
+  enum class AuraDisplayStage {
+    Begin, Request, Current, Resolved, Preferred, Active, Defaults, Matched,
+    ModeCount, WindowModeResult, Return, Unwound, TargetSpecified, ActiveResult, CountResult, ListResult,
+  };
+
+  class AuraDisplayTrace {
+    struct Errors {
+      int crt = errno;
+      DWORD win32 = GetLastError();
+      ~Errors() { SetLastError(win32); errno = crt; }
+    };
+    struct State {
+      bool enabled = false;
+      ULONGLONG start = 0;
+      std::atomic<uint32_t> rows { 0 }, calls { 0 };
+      State() noexcept {
+        try {
+          if (env::getEnvVar("AURA_BF3_DISPLAY_TRACE") != "1") return;
+          auto exe = env::getExeName();
+          for (char& ch : exe) if (ch >= 'A' && ch <= 'Z') ch += 'a' - 'A';
+          enabled = exe == "bf3.exe";
+          if (enabled) start = GetTickCount64();
+        } catch (...) { enabled = false; }
+      }
+    };
+    static State& state() { static State value; return value; }
+    static uint32_t& parent() { static thread_local uint32_t value = 0; return value; }
+    uint32_t m_id = 0, m_parent = 0, m_object = 0;
+    AuraDisplayCall m_call;
+    bool m_returned = false;
+
+    void emit(AuraDisplayStage stage, const DXGI_MODE_DESC1* mode = nullptr,
+              int windowed = -1, uint32_t flags = 0, bool flagsKnown = false,
+              uint32_t buffers = 0, uint32_t value = 0, bool resultKnown = false,
+              HRESULT result = 0) const noexcept {
+      if (!m_id) return;
+      Errors errors;
+      auto& s = state();
+      if (s.rows.load(std::memory_order_relaxed) >= 384) return;
+      auto now = GetTickCount64();
+      if (now - s.start >= 120000) return;
+      uint32_t row = s.rows.fetch_add(1, std::memory_order_relaxed);
+      if (row >= 384) return;
+      static const char* const calls[] = {
+        "CREATE", "CREATE_HWND", "CREATE_BASE", "CONSTRUCT", "RESIZE_BUFFERS", "RESIZE_BUFFERS1",
+        "RESIZE_TARGET", "FULLSCREEN", "ENTER", "LEAVE", "CHANGE_MODE", "RESTORE_MODE", "CLOSEST", "CLOSEST1",
+      };
+      static const char* const stages[] = {
+        "BEGIN", "REQUEST", "CURRENT", "RESOLVED", "PREFERRED", "ACTIVE", "DEFAULTS", "MATCHED",
+        "MODE_COUNT", "WINDOW_MODE_RESULT", "RETURN", "UNWOUND", "TARGET_SPECIFIED", "ACTIVE_RESULT", "COUNT_RESULT", "LIST_RESULT",
+      };
+      DXGI_MODE_DESC1 empty = {};
+      const auto& m = mode ? *mode : empty;
+      char line[640];
+      std::snprintf(line, sizeof(line),
+        "AURA_DXGI_MODE_V1 pid=%u; tid=%u; tick_ms=%llu; elapsed_ms=%llu; seq=%u; call=%u; parent=%u; object=%u; api=%s; stage=%s; mode_known=%u; width=%u; height=%u; hz_num=%u; hz_den=%u; format=%u; scan=%u; scaling=%u; stereo=%u; windowed=%d; flags_known=%u; flags=%u; buffers=%u; value=%u; result_known=%u; result=%d; budget_last=%u\n",
+        unsigned(GetCurrentProcessId()), unsigned(GetCurrentThreadId()),
+        (unsigned long long)now, (unsigned long long)(now - s.start), unsigned(row + 1),
+        unsigned(m_id), unsigned(m_parent), unsigned(m_object), calls[unsigned(m_call)], stages[unsigned(stage)],
+        unsigned(mode != nullptr), unsigned(m.Width), unsigned(m.Height), unsigned(m.RefreshRate.Numerator),
+        unsigned(m.RefreshRate.Denominator), unsigned(m.Format), unsigned(m.ScanlineOrdering), unsigned(m.Scaling),
+        unsigned(m.Stereo), windowed, unsigned(flagsKnown), unsigned(flags), unsigned(buffers), unsigned(value),
+        unsigned(resultKnown), int(result), unsigned(row == 383));
+      using WineOutput = int (__cdecl*)(const char*);
+      static const auto output = [] {
+        HMODULE module = GetModuleHandleA("ntdll.dll");
+        return module ? reinterpret_cast<WineOutput>(GetProcAddress(module, "__wine_dbg_output")) : nullptr;
+      }();
+      if (output) output(line);
+      else { std::fputs(line, stderr); std::fflush(stderr); }
+    }
+
+  public:
+    explicit AuraDisplayTrace(AuraDisplayCall call, uint32_t object = 0) noexcept : m_call(call) {
+      Errors errors;
+      auto& s = state();
+      if (!s.enabled || s.rows.load(std::memory_order_relaxed) >= 384 || GetTickCount64() - s.start >= 120000)
+        return;
+      m_id = s.calls.fetch_add(1, std::memory_order_relaxed) + 1;
+      m_parent = parent();
+      parent() = m_id;
+      m_object = object ? object : (call == AuraDisplayCall::Construct ? m_id : 0);
+      emit(AuraDisplayStage::Begin);
+    }
+    ~AuraDisplayTrace() {
+      if (!m_id) return;
+      Errors errors;
+      if (!m_returned) emit(AuraDisplayStage::Unwound);
+      parent() = m_parent;
+    }
+    AuraDisplayTrace(const AuraDisplayTrace&) = delete;
+    AuraDisplayTrace& operator=(const AuraDisplayTrace&) = delete;
+    uint32_t object() const { return m_object; }
+    HRESULT result(HRESULT hr) noexcept {
+      emit(AuraDisplayStage::Return, nullptr, -1, 0, false, 0, 0, true, hr);
+      m_returned = true;
+      return hr;
+    }
+    void point(AuraDisplayStage stage, uint32_t value) const noexcept {
+      emit(stage, nullptr, -1, 0, false, 0, value);
+    }
+    void status(AuraDisplayStage stage, HRESULT hr) const noexcept {
+      emit(stage, nullptr, -1, 0, false, 0, 0, true, hr);
+    }
+    void mode(AuraDisplayStage stage, const DXGI_MODE_DESC1* desc) const noexcept { emit(stage, desc); }
+    void mode(AuraDisplayStage stage, const DXGI_MODE_DESC* desc) const noexcept {
+      if (!m_id) return;
+      DXGI_MODE_DESC1 m = {};
+      if (desc) {
+        m.Width = desc->Width; m.Height = desc->Height; m.RefreshRate = desc->RefreshRate;
+        m.Format = desc->Format; m.ScanlineOrdering = desc->ScanlineOrdering; m.Scaling = desc->Scaling;
+      }
+      emit(stage, desc ? &m : nullptr);
+    }
+    void swap(AuraDisplayStage stage, const DXGI_SWAP_CHAIN_DESC1& desc,
+              const DXGI_SWAP_CHAIN_FULLSCREEN_DESC* fs = nullptr) const noexcept {
+      if (!m_id) return;
+      DXGI_MODE_DESC1 m = {};
+      m.Width = desc.Width; m.Height = desc.Height; m.Format = desc.Format; m.Stereo = desc.Stereo;
+      if (fs) { m.RefreshRate = fs->RefreshRate; m.ScanlineOrdering = fs->ScanlineOrdering; m.Scaling = fs->Scaling; }
+      emit(stage, &m, fs ? int(fs->Windowed) : -1, desc.Flags, true, desc.BufferCount);
+    }
+    void resize(UINT count, UINT width, UINT height, DXGI_FORMAT format, UINT flags) const noexcept {
+      if (!m_id) return;
+      DXGI_SWAP_CHAIN_DESC1 desc = {};
+      desc.Width = width; desc.Height = height; desc.Format = format; desc.Flags = flags; desc.BufferCount = count;
+      swap(AuraDisplayStage::Request, desc);
+    }
+  };
+}
