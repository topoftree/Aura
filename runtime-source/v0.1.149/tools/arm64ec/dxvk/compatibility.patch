diff --git a/src/util/util_aura_init.h b/src/util/util_aura_init.h
new file mode 100644
index 0000000..0281858
--- /dev/null
+++ b/src/util/util_aura_init.h
@@ -0,0 +1,71 @@
+#pragma once
+
+#include <atomic>
+#include <cerrno>
+#include <cstdint>
+#include <cstdio>
+
+#include "util_env.h"
+
+namespace dxvk {
+
+  // Fixed fields only, opt-in before Wine starts. No paths, names, handles,
+  // addresses, environment dumps or frame-time logging. This is not proof
+  // that a game is ready. The host retains output only for its active capture.
+  enum class AuraInitStage : uint32_t {
+    Loader, InstanceLayers, InstanceExtensionsCount, InstanceExtensionsList,
+    CreateInstance, AdaptersCount, AdaptersList, AdapterApi, AdapterAccepted,
+    AdaptersAccepted, FactoryResult,
+    RejectApi, RejectGraphicsQueue, RejectFeature, RejectPushConstants,
+    RejectNameFilter, RejectUuidFilter, RejectSoftwareDevice,
+    CompatCaps, CreateDevice,
+  };
+
+  inline void auraInitTrace(AuraInitStage stage, int32_t result, uint32_t value = 0) {
+#ifdef _WIN32
+    struct SavedErrors {
+      int crt = errno;
+      DWORD win32 = GetLastError();
+      ~SavedErrors() { errno = crt; SetLastError(win32); }
+    } savedErrors;
+    static const bool enabled = env::getEnvVar("AURA_DXVK_INIT_TRACE") == "1";
+    if (!enabled)
+      return;
+
+    static const ULONGLONG started = GetTickCount64();
+    static std::atomic<uint32_t> lines { 0u };
+    if (GetTickCount64() - started >= 120000u || lines.load() >= 64u)
+      return;
+    if (lines.fetch_add(1u) >= 64u)
+      return;
+
+    static const char* const names[] = {
+      "LOADER", "INSTANCE_LAYERS", "INSTANCE_EXTENSIONS_COUNT", "INSTANCE_EXTENSIONS_LIST",
+      "CREATE_INSTANCE", "ADAPTERS_COUNT", "ADAPTERS_LIST", "ADAPTER_API", "ADAPTER_ACCEPTED",
+      "ADAPTERS_ACCEPTED", "FACTORY_RESULT",
+      "REJECT_API", "REJECT_GRAPHICS_QUEUE", "REJECT_FEATURE", "REJECT_PUSH_CONSTANTS",
+      "REJECT_NAME_FILTER", "REJECT_UUID_FILTER", "REJECT_SOFTWARE_DEVICE",
+      "COMPAT_CAPS", "CREATE_DEVICE",
+    };
+    uint32_t index = uint32_t(stage);
+    if (index >= sizeof(names) / sizeof(names[0]))
+      return;
+
+    char line[192];
+    std::snprintf(line, sizeof(line), "AURA_DXVK_INIT_V1 pid=%u; stage=%s; result=%d; value=%u\n",
+      unsigned(GetCurrentProcessId()), names[index], int(result), unsigned(value));
+    using WineOutput = int (__cdecl*)(const char*);
+    static const auto output = [] {
+      HMODULE module = GetModuleHandleA("ntdll.dll");
+      return module ? reinterpret_cast<WineOutput>(GetProcAddress(module, "__wine_dbg_output")) : nullptr;
+    }();
+    if (output)
+      output(line);
+    else {
+      std::fputs(line, stderr);
+      std::fflush(stderr);
+    }
+#endif
+  }
+
+}
