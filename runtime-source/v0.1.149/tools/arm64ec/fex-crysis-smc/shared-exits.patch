+  if (CTX->Config.CrysisSharedSMCExits() && !CTX->Config.Is64BitMode() &&
+      CTX->Config.SMCChecks() == FEXCore::Config::CONFIG_SMC_FULL) {
+    // Key the complete ordered operand pair after register allocation. Reuse
+    // only an identical exit, preserving the original spill/RIP/ABI order and
+    // all flags. The ordinary instruction checks and their branches stay put.
+    const uint16_t Key = (GetReg(Op->EntryToInvalidate).Idx() << 5) | GetReg(Op->NewRIP).Idx();
+    auto [Exit, First] = SharedSMCExits.try_emplace(Key);
+    if (!First) {
+      b_OrRestart(&Exit->second);
+      return;
+    }
+    BindOrRestart(&Exit->second);
+  }
+
   SpillStaticRegs(TMP1);
 
